<?php

/**
 * @file
 * Base module for DrevOps Website.
 */

declare(strict_types=1);

/**
 * Implements hook_xmlsitemap_link_alter().
 */
function do_base_xmlsitemap_link_alter(array &$link): void {
  $front = \Drupal::config('system.site')->get('page.front');

  // The front page already has its own "/" entry. Without this, the node
  // behind it is listed a second time under its internal path, and the two
  // entries serve identical content to search engines.
  if ($link['type'] !== 'frontpage' && $link['loc'] === $front) {
    $link['status'] = 0;
  }
}
