// audit-ci allowlist for the theme.
//
// Lists the npm advisories that the security audit skips. An entry stops
// applying once its expiry date is reached.
//
// https://github.com/IBM/audit-ci
{
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  "allowlist": [
    {
      "GHSA-vfj7-8cjw-p6xm": {
        "active": true,
        "notes": "No patched braces release exists yet. It is reached only through stylelint, which expands the glob patterns in the theme's lint scripts, so no outside input reaches it and nothing from it ships with the site.",
        "expiry": "2026-12-31"
      }
    },
    {
      "GHSA-fp25-p6mj-qqg6": {
        "active": true,
        "notes": "locutus 2.x is pinned by drupal-twig-extensions (^2.0.16), which has no release on locutus 3.x. It runs only in the Vite and Storybook build, rendering the theme's own Twig templates, and nothing from it ships with the site.",
        "expiry": "2026-12-31"
      }
    },
    {
      "GHSA-vh9h-29pq-r5m8": {
        "active": true,
        "notes": "locutus 2.x via drupal-twig-extensions; build-time only, see GHSA-fp25-p6mj-qqg6.",
        "expiry": "2026-12-31"
      }
    }
  ]
}
