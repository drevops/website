--- /dev/null
+++ b/modules/environment_indicator_navigation/css/navigation.css
@@ -0,0 +1,16 @@
+/**
+ * @file
+ * Environment colour on the Navigation sidebar.
+ *
+ * The sidebar is 'box-sizing: border-box', so the border is drawn inside its
+ * fixed width and the displacement offsets applied to the page stay correct.
+ * Core claims 'border-inline-end' on this element but never the inline start.
+ *
+ * The width carries its own property name rather than reusing the parent
+ * module's '--environment-indicator-border-width': that one is defined at
+ * ':root' by CSS the parent still attaches, and would override this value.
+ */
+
+.admin-toolbar {
+  border-inline-start: var(--environment-indicator-navigation-width, 8px) solid var(--environment-indicator-navigation-color, transparent);
+}
